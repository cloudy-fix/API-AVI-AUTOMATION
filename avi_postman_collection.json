{
  "info": {
    "name": "AVI API Automation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "avi_controller_url",
      "value": "https://avi-controller.example.com"
    },
    {
      "key": "avi_username",
      "value": "replace-with-controller-user"
    },
    {
      "key": "avi_password",
      "value": "replace-with-controller-password"
    },
    {
      "key": "avi_tenant_name",
      "value": "test-tenant"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{avi_controller_url}}/login"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{avi_username}}\", \"password\": \"{{avi_password}}\"}"
        }
      }
    },
    {
      "name": "Create Tenant",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{avi_controller_url}}/api/tenant"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"{{avi_tenant_name}}\", \"description\": \"Created via Postman\"}"
        }
      }
    }
  ]
}

